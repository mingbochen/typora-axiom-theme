{
  "name": "typora-axiom-theme",
  "version": "0.2.7",
  "private": true,
  "description": "An offline light Typora theme inspired by the ChatGPT / Codex reading experience.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "preview": "node scripts/preview.cjs",
    "check": "node scripts/check.cjs",
    "capture": "node scripts/capture.cjs",
    "check:native-css": "node scripts/native-cascade.cjs",
    "check:engines": "node scripts/engine-qa.cjs",
    "check:inline-math": "node scripts/inline-math-qa.cjs",
    "check:print": "node scripts/print-qa.cjs",
    "check:focus-print": "node scripts/focus-print-qa.cjs",
    "check:fonts": "node scripts/font-qa.cjs",
    "check:export": "node scripts/export-qa.cjs",
